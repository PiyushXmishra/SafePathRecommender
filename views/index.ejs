<% include partials/header %>

<main class="page-content">
    <section class="hero-panel">
        <div class="hero-copy">
            <p class="eyebrow">Urban Route Intelligence</p>
            <h1>Choose routes with more context, not just distance.</h1>
            <p class="hero-text">
                Safe Path Recommender helps you compare route safety using mapped incident patterns,
                so every trip starts with a clearer picture of local risk.
            </p>

            <div class="hero-actions">
                <a href="/maps" class="button button-primary">Launch Route Explorer</a>
                <a href="/signup" class="button button-secondary">Create Account</a>
            </div>
        </div>

        <div class="hero-card-stack">
            <div class="insight-card">
                <p class="card-kicker">Live Score</p>
                <h3>Risk-aware route analysis</h3>
                <p>Search for a route and see danger scoring update directly in the interface.</p>
            </div>
            <div class="insight-card">
                <p class="card-kicker">Map Layer</p>
                <h3>Incident-aware visualization</h3>
                <p>Overlay crime hotspots with route geometry to make safety tradeoffs easier to spot.</p>
            </div>
        </div>
    </section>

    <section class="feature-grid">
        <article class="feature-card">
            <p class="card-kicker">Routing</p>
            <h2>Compare routes through a safety lens</h2>
            <p>
                Go beyond shortest-path thinking with route insights shaped by nearby incident concentration.
            </p>
        </article>

        <article class="feature-card">
            <p class="card-kicker">Interface</p>
            <h2>Live feedback without noisy popups</h2>
            <p>
                Search state, danger score, and route quality stay visible in one dashboard-style experience.
            </p>
        </article>

        <article class="feature-card">
            <p class="card-kicker">Next Step</p>
            <h2>Ready for a trained risk model</h2>
            <p>
                The UI is set up to evolve from heuristic scoring into model-backed route recommendations.
            </p>
        </article>
    </section>
</main>

</div>
</body>
</html>
