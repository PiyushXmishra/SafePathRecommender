<% include partials/header %>

<main class="page-content auth-layout">
    <section class="auth-panel">
        <div class="auth-copy">
            <p class="eyebrow">Get Started</p>
            <h1>Create your access point to the route safety dashboard.</h1>
            <p class="hero-text">
                Set up a simple account and move directly into the map experience with the same refreshed product theme.
            </p>
        </div>

        <form action="/signup" method="POST" class="auth-form">
            <h2>Sign Up</h2>

            <label class="field-label" for="username">Username</label>
            <input id="username" type="text" placeholder="Choose a username" name="username" class="field-input">

            <label class="field-label" for="password">Password</label>
            <input id="password" type="password" placeholder="Create a password" name="password" class="field-input">

            <button class="button button-primary button-block" type="submit">Create Account</button>

            <p class="auth-switch">
                Already have an account? <a href="/login">Login</a>
            </p>
        </form>
    </section>
</main>

</div>
</body>
</html>
