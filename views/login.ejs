<% include partials/header %>

<main class="page-content auth-layout">
    <section class="auth-panel">
        <div class="auth-copy">
            <p class="eyebrow">Welcome Back</p>
            <h1>Sign in to continue exploring safer routes.</h1>
            <p class="hero-text">
                Access the route experience, review live safety scoring, and keep the product flow consistent across searches.
            </p>
        </div>

        <form action="/login" method="POST" class="auth-form">
            <h2>Login</h2>

            <label class="field-label" for="username">Username</label>
            <input id="username" type="text" placeholder="Enter username" name="username" class="field-input">

            <label class="field-label" for="password">Password</label>
            <input id="password" type="password" placeholder="Enter password" name="password" class="field-input">

            <button class="button button-primary button-block" type="submit">Continue</button>

            <p class="auth-switch">
                New here? <a href="/signup">Create an account</a>
            </p>
        </form>
    </section>
</main>

</div>
</body>
</html>
